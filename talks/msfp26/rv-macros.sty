\ProvidesPackage{rv-macros}

\RequirePackage{tikz}

\usetikzlibrary{shapes.geometric}
\usetikzlibrary{calc}
\usetikzlibrary{fit}
\usetikzlibrary{backgrounds}


\newcommand{\cat}[1]{\mathcal{#1}}

\tikzset{
  every picture/.style={scale=0.75,transform shape},
  operator/.style={
      draw,
      ellipse,
      inner xsep=0pt,
      inner ysep=2pt,
      minimum width=4ex,
      minimum height=4ex,
    },
  inputwire/.style={
      above,
      align=left,
      pos=0.3,
      sloped=false,
    },
  outputwire/.style={
      above,
      inner sep=2pt,
      align=right,
      pos=0.7,
      sloped=false,
    },
  wirelabel/.style={
      inner sep=2pt,
    },
  diff/.style={
      draw=red,
      very thin,
      fill opacity=0.1,
      fill=red,
      ellipse
  },
  result/.style={
      draw=red,
      dashed,
      very thin,
      fill opacity=0.1,
      fill=red,
      ellipse
  },
}

\newcommand{\Nullary}[2]{%
  \begin{tikzpicture}[baseline=(op.base),inner sep=1ex]
    \node[operator] (op) at (0,0) {\ensuremath{#1}};
    \node[anchor=west] (out) at ($(op.east)+(1,0)$) {};
    \path[use as bounding box] ($(op.west)+(-0.15,-0.9)$) rectangle ($(out.west)+(0,0.9)$);
    \draw (op.east) -- (out.west) node[outputwire,above] {\ensuremath{#2}};
  \end{tikzpicture}%
}

\newcommand{\Unary}[3]{%
  \begin{tikzpicture}[baseline=(op.base),inner sep=1ex]
    \node[operator] (op) at (0,0) {\ensuremath{#2}};
    \node[anchor=east] (in) at ($(op.west)+(-1,0)$) {};
    \node[anchor=west] (out) at ($(op.east)+(1,0)$) {};
    \draw (in.east) -- node[inputwire,above] {\ensuremath{#1}} (op.west);
    \draw (op.east) -- node[outputwire,above] {\ensuremath{#3}} (out.west);
  \end{tikzpicture}%
}

\newcommand{\Binary}[4]{%
  \begin{tikzpicture}[baseline=(op.base),inner sep=1ex]
    \node[operator] (op) at (0,0) {\ensuremath{#3}};
    \node[anchor=east] (in1) at ($(op.140)+(-1,0.4)$) {};
    \node[anchor=east] (in2) at ($(op.220)+(-1,-0.4)$) {};
    \node[anchor=west] (out) at ($(op.east)+(1,0)$) {};
    \draw (in1.east) to[out=0,in=140] node[inputwire,above,sloped=false] {\ensuremath{#1}} (op.140);
    \draw (in2.east) to[out=0,in=220] node[inputwire,below,sloped=false] {\ensuremath{#2}} (op.220);
    \draw (op.east) -- (out.west) node[outputwire,above] {\ensuremath{#4}};
  \end{tikzpicture}%
}


\newcommand{\nil}{\operatorname{\mathsf{nil}}}
\newcommand{\cons}{\operatorname{\mathsf{cons}}}
\newcommand{\iter}{\operatorname{\mathsf{it}}}
\newcommand{\checkiter}{\check{\operatorname{\mathsf{it}}}}
\newcommand{\id}{\operatorname{\mathsf{id}}}

\newcommand{\Cons}{:\kern-3mu:}
\newcommand{\App}{+\kern-0.4em+}
