                \draw[blue] (cons) -- (out);

                \begin{scope}[on background layer]
                    \node[
                        fit=(nil)(cons),
                        diff,
                        rotate=30,
                        inner sep=-3pt,
                    ] {};
                \end{scope}
            \end{scope}

            \node at (1.6,-2) {$=$};

            \begin{scope}[xshift=4.3cm,yshift=-2cm]
                \node[operator] (eta) at ($(nil |- 0,0)+(0.6,0)$) {$\eta$};

